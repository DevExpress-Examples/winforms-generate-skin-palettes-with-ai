<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>12</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ForceDesignerDPIUnaware>true</ForceDesignerDPIUnaware>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.3.0-beta.2" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
    <PackageReference Include="DevExpress.Win.Design" Version="26.2.2-beta" />
    <PackageReference Include="DevExpress.AIIntegration.WinForms.Chat" Version="26.2.2-beta" />
	<PackageReference Include="DevExpress.Images.Blazor" Version="26.2.2-beta" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="GeneratePaletteExtension\GeneratePaletteInstruction.md" />
  </ItemGroup>
  <!-- Microsoft.AspNetCore.Components.WebView adds the host assets (blazor.webview.js, blazor.modules.json)
       to every project that references it. This is a class library: the host application adds these assets itself. -->
  <Target Name="RemoveBlazorWebViewHostAssets" AfterTargets="_AddBlazorWebViewAssets">
    <ItemGroup>
      <StaticWebAsset Remove="@(_WebViewFrameworkStaticWebAsset)" />
    </ItemGroup>
  </Target>
</Project>